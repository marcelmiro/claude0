[Unit]
Description=Claude0 monitor fallback for detached tmux
After=tmux.service
BindsTo=tmux.service

[Service]
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# tmux runs status-right's `#(claude0 status)` only while a client is attached — but a
# headless host's steady state is detached, which is exactly when transition pushes
# matter most. This loop ticks the monitor ONLY when no client is attached, so the
# two tick sources never run concurrently. Continuum's 15-min autosave rides the
# same status-right, so it too never fires while detached — the loop mirrors it
# with a resurrect save every 300 detached ticks (~15 min), keeping the layout and
# pane→session map fresh for a hard reboot (ExecStop only covers a clean stop).
ExecStart=/bin/bash -c 'n=0; while true; do if [ -z "$(tmux list-clients 2>/dev/null)" ]; then claude0 status >/dev/null 2>&1; n=$((n+1)); if [ "$n" -ge 300 ]; then n=0; claude0 resurrect save >/dev/null 2>&1 || true; fi; fi; sleep 3; done'
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
