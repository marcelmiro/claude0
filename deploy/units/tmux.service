[Unit]
Description=tmux server (hosts all Claude Code sessions)

[Service]
Type=forking
# User units get no login-shell PATH, and environment.d is only read when the user
# manager starts — a file written later is invisible until reboot. The units carry
# their PATH themselves so install order can never break them (%h = user home).
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# has-session guard: Ubuntu's tmux is systemd-aware and a server surviving a failed
# start attempt escapes into its own scope — a bare new-session then fails with
# "duplicate session" forever.
ExecStart=/bin/bash -c 'tmux has-session -t main 2>/dev/null || tmux new-session -d -s main'
# Restore is owned HERE, not by continuum's restore-on-server-start: that path races
# the forking handshake under systemd (tmux-continuum #110) and killed the server.
# resurrect recreates the saved layout, then its post-restore hook runs
# `claude0 restore-sessions` to resume each pane's Claude session. claude0
# resolves the plugin install at runtime (user-managed or claude0-owned).
ExecStartPost=/bin/bash -c 'sleep 1; claude0 resurrect restore || true'
# Save the pane→session map on the way down so restore-sessions can resume every
# Claude session after the reboot. claude0 resolves via the unit's own PATH above.
ExecStop=/bin/bash -c 'claude0 save-sessions; /usr/bin/tmux kill-server'
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
