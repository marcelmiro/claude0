#!/bin/sh
# Start the local or remote tmux environment used by Claude0. All durable choices
# live in the single user-editable config.json; the terminal.* values are baked
# in here when `claude0 setup` renders this script, so config edits take effect
# after re-running setup. CLI arguments and CLAUDE0_* env vars are transient.

PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.bun/bin:/usr/bin:/bin:${PATH:-}"
export PATH

usage() {
  cat <<'EOF'
Usage: claude0 terminal [local|remote|status]

With no argument, uses terminal.defaultTarget from ~/.config/claude0/config.json.
Edit the file shown by: claude0 config — then re-run: claude0 setup
EOF
}

command=${1:-}
case "$command" in
  status)
    host={{REMOTE_HOST}}
    printf 'default_target=%s\n' {{DEFAULT_TARGET}}
    printf 'remote_host=%s\n' "${host:-<unset>}"
    printf 'local_session=%s\n' {{LOCAL_SESSION}}
    printf 'remote_session=%s\n' {{REMOTE_SESSION}}
    exit 0
    ;;
  local|remote) mode=$command ;;
  -h|--help|help) usage; exit 0 ;;
  '') mode={{DEFAULT_TARGET}} ;;
  *) usage >&2; exit 2 ;;
esac

case "$mode" in
  local)
    session=${CLAUDE0_LOCAL_TMUX_SESSION:-{{LOCAL_SESSION}}}
    command -v tmux >/dev/null 2>&1 || {
      printf 'tmux is required for local Claude0 mode.\n' >&2
      exit 127
    }
    tmux new-session -A -s "$session"
    ;;
  remote)
    host=${CLAUDE0_REMOTE_HOST:-{{REMOTE_HOST}}}
    session=${CLAUDE0_REMOTE_TMUX_SESSION:-{{REMOTE_SESSION}}}
    [ -n "$host" ] || {
      printf 'No remote host configured. Set terminal.remoteHost in ~/.config/claude0/config.json, then re-run: claude0 setup\n' >&2
      exit 2
    }
    command -v mosh >/dev/null 2>&1 || {
      printf 'Mosh is required for remote Claude0 mode.\n' >&2
      exit 127
    }
    mosh --predict=always \
      --server='env MOSH_SERVER_NETWORK_TMOUT=2592000 mosh-server' \
      "$host" -- tmux new-session -A -s "$session"
    ;;
esac
